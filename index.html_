<!DOCTYPE html>
<html lang="es">
<head>
  
        <!-- VISTA 2: MI DESPENSA -->
        <div id="vista-despensa" class="w-full h-full flex flex-col justify-between hidden relative z-10 bg-slate-50">
            <header class="bg-gradient-to-b from-[#2d4c08] to-[#3b630b] pt-5 pb-4 px-5 text-white rounded-b-3xl shadow-md">
                <div class="flex justify-between items-center mb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-emerald-100 border-2 border-white flex items-center justify-center overflow-hidden shadow-sm">
                            <img id="header-avatar-img" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300" class="w-full h-full object-cover">
                        </div>
                        <div>
                            <h2 class="text-xs font-semibold text-emerald-200">¡Hola, Sofía! 👋</h2>
                            <p class="text-sm font-bold tracking-tight">Mi Despensa</p>
                        </div>
                    </div>

                    <!-- BADGE CON ZANAHORIA Y DIAS -->
                    <button type="button" onclick="irA('perfil')" class="bg-orange-400/20 border border-orange-300/40 px-3 py-1 rounded-full flex items-center gap-1.5 shadow-inner hover:bg-orange-400/30 transition cursor-pointer">
                        <span class="text-xs animate-bounce">🥕</span>
                        <span id="header-racha-dias" class="text-xs font-extrabold text-orange-200">0 días</span>
                    </button>
                </div>

                <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-2.5 flex items-center justify-between text-xs">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-leaf text-emerald-300 text-sm"></i>
                        <span>Has salvado <b id="header-kg-salvados">0.0 kg</b> este mes</span>
                    </div>
                    <span id="badge-tipo-usuario-header" class="bg-emerald-400/30 px-2 py-0.5 rounded-full text-[10px] font-bold text-emerald-100">Hogar 🏡</span>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
                
                <!-- BANNER DE MENSAJE DEL SR. BIGOTES -->
                <div id="banner-sr-bigotes-despensa" class="rounded-2xl p-3 text-slate-800 shadow-sm flex items-center gap-3 relative overflow-hidden transition-all duration-300 bg-sky-100 border border-sky-200">
                    <div id="svg-sr-bigotes-despensa" class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0 bg-white/80 p-1 shadow-sm overflow-hidden">
                        <!-- Generado en JS -->
                    </div>
                    <div class="flex-1 text-[11px]">
                        <p class="font-bold leading-tight" id="mensaje-sr-bigotes">¡Hola! Soy el Sr. Bigotes. Agrega alimentos para alimentar mi racha de zanahorias 🥕</p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <div class="flex-1 flex items-center bg-white rounded-2xl px-3.5 py-2 border border-slate-200 shadow-sm focus-within:border-emerald-600 transition">
                        <i class="fa-solid fa-magnifying-glass text-slate-400 text-xs mr-2"></i>
                        <input type="text" id="input-buscar" oninput="renderizarAlimentos()" placeholder="Buscar en mi despensa..." class="bg-transparent text-xs w-full text-slate-700 outline-none">
                    </div>
                    <button type="button" onclick="abrirModalFiltros()" class="w-9 h-9 rounded-2xl bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-600 active:bg-slate-100 transition cursor-pointer" title="Filtrar y Ordenar">
                        <i class="fa-solid fa-sliders text-xs"></i>
                    </button>
                </div>

                <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar text-xs">
                    <button type="button" id="btn-cat-todos" onclick="filtrarCategoria('todos')" class="cat-btn active px-3.5 py-1.5 rounded-xl font-bold bg-[#3b630b] text-white shadow-sm whitespace-nowrap transition cursor-pointer">
                        Todos (0)
                    </button>
                    <button type="button" id="btn-cat-vence" onclick="filtrarCategoria('vence')" class="cat-btn px-3.5 py-1.5 rounded-xl font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap transition cursor-pointer">
                        🔴 Vence pronto (0)
                    </button>
                    <button type="button" id="btn-cat-frescos" onclick="filtrarCategoria('frescos')" class="cat-btn px-3.5 py-1.5 rounded-xl font-semibold bg-white border border-slate-200 text-slate-600 whitespace-nowrap transition cursor-pointer">
                        🟢 Frescos (0)
                    </button>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <h3 class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-red-500"></span> Consumir Pronto
                        </h3>
                        <span class="text-[10px] text-red-600 font-bold bg-red-50 px-2 py-0.5 rounded-full border border-red-200">¡Prioridad!</span>
                    </div>
                    <div id="contenedor-vence-pronto" class="space-y-2"></div>
                </div>

                <div>
                    <h3 class="text-xs font-bold text-slate-700 mb-2 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> En Buen Estado
                    </h3>
                    <div id="contenedor-frescos" class="grid grid-cols-2 gap-2"></div>
                </div>
            </main>

            <nav class="bg-white border-t border-slate-200/80 px-4 py-2 flex justify-around items-center rounded-t-3xl shadow-lg">
                <button type="button" id="nav-btn-despensa" onclick="irA('despensa')" class="flex flex-col items-center text-[#3b630b] font-bold text-[10px] cursor-pointer">
                    <i class="fa-solid fa-box-archive text-base mb-0.5"></i>
                    <span>Despensa</span>
                </button>
                <button type="button" onclick="alert('Módulo de Recetas en desarrollo 🍳')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-solid fa-utensils text-base mb-0.5"></i>
                    <span>Recetas</span>
                </button>
                <button type="button" onclick="abrirModalAgregar()" class="w-11 h-11 rounded-full bg-[#3b630b] text-white flex items-center justify-center -mt-6 shadow-lg active:scale-95 transition cursor-pointer border-4 border-slate-50">
                    <i class="fa-solid fa-plus text-lg"></i>
                </button>
                <button type="button" onclick="alert('Módulo de Donación en desarrollo 🤝')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-solid fa-hand-holding-heart text-base mb-0.5"></i>
                    <span>Donar</span>
                </button>
                <button type="button" id="nav-btn-perfil" onclick="irA('perfil')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-regular fa-user text-base mb-0.5"></i>
                    <span>Perfil</span>
                </button>
            </nav>
        </div>

        <!-- VISTA 3: FICHA DE DETALLE DEL ALIMENTO -->
        <div id="vista-detalle-alimento" class="w-full h-full flex flex-col justify-between hidden relative z-20 bg-slate-50">
            <div class="relative w-full h-52 bg-slate-200">
                <img id="det-imagen" src="" alt="Alimento" class="w-full h-full object-cover">
                <button type="button" onclick="cerrarDetalleAlimento()" class="absolute top-4 left-4 w-9 h-9 rounded-full bg-black/40 backdrop-blur-md text-white flex items-center justify-center shadow-lg active:scale-90 transition cursor-pointer">
                    <i class="fa-solid fa-arrow-left text-sm"></i>
                </button>
            </div>

            <main class="flex-1 overflow-y-auto p-5 -mt-4 bg-slate-50 rounded-t-3xl relative z-10 space-y-4">
                <div class="flex justify-between items-start">
                    <div>
                        <span id="det-emoji" class="text-3xl">🍌</span>
                        <h2 id="det-nombre" class="text-lg font-bold text-slate-800 mt-1">Nombre</h2>
                        <p id="det-cantidad" class="text-xs text-slate-500 font-medium">Cantidad</p>
                    </div>
                    <span id="det-badge-vencimiento" class="bg-red-100 text-red-700 border border-red-200 font-bold text-xs px-3 py-1 rounded-full">
                        Vencimiento
                    </span>
                </div>

                <div class="bg-white p-3 rounded-2xl border border-slate-200/80 shadow-sm space-y-1.5">
                    <div class="flex justify-between text-[11px] font-bold text-slate-600">
                        <span>Estado de Frescura:</span>
                        <span id="det-porcentaje-frescura" class="text-red-600">20% Restante</span>
                    </div>
                    <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                        <div id="det-barra-frescura" class="bg-red-500 h-full rounded-full transition-all duration-500" style="width: 20%;"></div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl p-3.5 border border-slate-200/80 shadow-sm space-y-2.5 text-xs text-slate-600">
                    <div class="flex justify-between border-b border-slate-100 pb-2">
                        <span class="font-bold text-slate-700">Ubicación:</span>
                        <span id="det-ubicacion">Ubicación</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="font-bold text-slate-700">Consejo del Sr. Bigotes:</span>
                        <span class="text-emerald-700 font-semibold">Ideal para consumir o donar hoy</span>
                    </div>
                </div>

                <div class="space-y-2 pt-1">
                    <button type="button" onclick="sugerirRecetaDetalle()" class="w-full bg-[#3b630b] text-white font-bold text-xs py-3 rounded-2xl shadow-md flex items-center justify-center gap-2 active:scale-95 transition cursor-pointer">
                        <i class="fa-solid fa-utensils"></i> Ver Recetas de Rescate
                    </button>
                    
                    <div class="flex gap-2">
                        <button type="button" onclick="donarDesdeDetalle()" class="flex-1 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs py-2.5 rounded-2xl shadow-sm flex items-center justify-center gap-1.5 active:scale-95 transition cursor-pointer">
                            <i class="fa-solid fa-hand-holding-heart"></i> Donar
                        </button>
                        <button type="button" onclick="consumirDesdeDetalle()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2.5 rounded-2xl shadow-sm flex items-center justify-center gap-1.5 active:scale-95 transition cursor-pointer">
                            <i class="fa-solid fa-check"></i> Consumido
                        </button>
                    </div>
                </div>
            </main>
        </div>

        <!-- VISTA 4: PERFIL MÓVIL Y TARJETA VECTORIAL DEL SR. BIGOTES -->
        <div id="vista-perfil" class="w-full h-full flex flex-col justify-between hidden relative z-10 bg-slate-50">
            <header class="bg-gradient-to-b from-[#2d4c08] to-[#3b630b] pt-6 pb-6 px-5 text-white rounded-b-3xl shadow-md text-center relative">
                <input type="file" id="input-foto-perfil" accept="image/*" capture="user" onchange="procesarFotoPerfil(event)" class="hidden">
                
                <div class="relative w-20 h-20 mx-auto mb-2 cursor-pointer group" onclick="document.getElementById('input-foto-perfil').click()">
                    <img id="perfil-avatar-img" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300" class="w-full h-full rounded-full object-cover border-4 border-white shadow-md group-hover:opacity-90 transition">
                    <div class="absolute bottom-0 right-0 w-7 h-7 rounded-full bg-emerald-600 border-2 border-white flex items-center justify-center text-white text-[10px] shadow-sm">
                        <i class="fa-solid fa-camera"></i>
                    </div>
                </div>

                <h2 class="text-base font-bold">Sofía Garay</h2>
                <p class="text-[11px] text-emerald-200 font-medium">sofia.garay@email.com</p>
                
                <div class="flex justify-center items-center gap-2 mt-2">
                    <span id="perfil-badge-tipo" class="px-3 py-0.5 rounded-full bg-emerald-400/20 border border-emerald-300/40 text-[10px] font-bold text-emerald-100">
                        🏡 Perfil Hogar
                    </span>
                    <span id="badge-nivel-usuario" class="px-3 py-0.5 rounded-full bg-amber-400/20 border border-amber-300/40 text-[10px] font-bold text-amber-200 flex items-center gap-1">
                        <i class="fa-solid fa-award text-xs"></i> Nivel 1 • Principiante
                    </span>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto px-4 py-3 space-y-3">
                
                <!-- TARJETA DEL SR. BIGOTES CON CAMBIO DE COLOR E ILUSTRACIÓN SVG -->
                <div id="card-racha-perfil" class="rounded-2xl p-4 text-slate-900 shadow-md relative overflow-hidden flex items-center justify-between border-2 transition-all duration-300 bg-sky-100 border-sky-300">
                    <div class="z-10 flex-1 pr-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-600 block">Racha con el Sr. Bigotes</span>
                        
                        <!-- TEXTO EN LETRAS GRANDES DEL DÍA -->
                        <h3 id="texto-dia-grande" class="text-xl font-black text-slate-800 tracking-tight mt-0.5">
                            DÍA 0 🥕
                        </h3>

                        <p class="text-[11px] font-extrabold text-slate-700 mt-1 flex items-center gap-1">
                            🔥 <span id="perfil-racha-dias">0 Días Consecutivos</span>
                        </p>
                        
                        <p class="text-[10px] text-slate-600 mt-0.5" id="perfil-racha-subtexto">
                            ¡Agrega alimentos para iniciar tu racha!
                        </p>
                    </div>

                    <!-- CONTENEDOR VECTORIAL DEL SR. BIGOTES -->
                    <div class="w-20 h-24 bg-white/80 backdrop-blur-md rounded-2xl flex flex-col items-center justify-center p-1 shadow-inner border border-white shrink-0 relative">
                        <div id="svg-sr-bigotes-perfil" class="w-full h-full flex items-center justify-center">
                            <!-- Generado por JS -->
                        </div>
                        <span id="badge-tag-dia" class="absolute -bottom-2 bg-slate-800 text-white text-[9px] font-extrabold px-2 py-0.5 rounded-full shadow">
                            DÍA 0
                        </span>
                    </div>
                </div>

                <!-- IMPACTO Y ESTADÍSTICAS -->
                <div class="bg-white rounded-2xl p-3.5 border border-slate-200/80 shadow-sm space-y-2.5">
                    <h3 class="text-xs font-bold text-slate-800 flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                            <i class="fa-solid fa-chart-line text-emerald-600 text-sm"></i> Mi Impacto Estimado
                        </span>
                        <span id="perfil-dinero-ahorro" class="text-[10px] font-extrabold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">
                            $0 COP Ahorrados
                        </span>
                    </h3>

                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="bg-emerald-50 border border-emerald-100 p-2 rounded-xl">
                            <span id="perfil-stat-kg" class="block text-sm font-bold text-emerald-800">0.0 kg</span>
                            <span class="text-[9px] text-emerald-600 font-medium">Salvados</span>
                        </div>
                        <div class="bg-amber-50 border border-amber-100 p-2 rounded-xl">
                            <span id="perfil-stat-recetas" class="block text-sm font-bold text-amber-800">0</span>
                            <span id="label-stat-centro" class="text-[9px] text-amber-600 font-medium">Recetas</span>
                        </div>
                        <div class="bg-blue-50 border border-blue-100 p-2 rounded-xl">
                            <span id="perfil-stat-donaciones" class="block text-sm font-bold text-blue-800">0</span>
                            <span class="text-[9px] text-blue-600 font-medium">Donaciones</span>
                        </div>
                    </div>
                </div>

                <!-- INSIGNIAS DINÁMICAS -->
                <div class="bg-white rounded-2xl p-3.5 border border-slate-200/80 shadow-sm space-y-2">
                    <h3 class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                        <i class="fa-solid fa-trophy text-amber-500 text-sm"></i> Mis Insignias y Logros
                    </h3>
                    <div class="grid grid-cols-4 gap-2 text-center pt-1" id="contenedor-insignias">
                        <!-- Generado dinámicamente por JS -->
                    </div>
                </div>

                <!-- OPCIONES DE CUENTA Y AJUSTES -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden text-xs text-slate-700 space-y-1">
                    <button type="button" onclick="toggleTipoCuenta()" class="w-full px-4 py-3 flex items-center justify-between border-b border-slate-100 hover:bg-slate-50 transition cursor-pointer">
                        <span class="flex items-center gap-2.5 font-bold text-emerald-800">
                            <i id="icono-toggle-cuenta" class="fa-solid fa-store"></i>
                            <span id="texto-toggle-cuenta">Cambiar a Perfil Empresa / Comercio</span>
                        </span>
                        <i class="fa-solid fa-chevron-right text-slate-400 text-[10px]"></i>
                    </button>

                    <button type="button" onclick="reiniciarProgreso()" class="w-full px-4 py-3 flex items-center justify-between border-b border-slate-100 hover:bg-slate-50 transition cursor-pointer text-amber-600">
                        <span class="flex items-center gap-2.5 font-bold">
                            <i class="fa-solid fa-rotate-right"></i>
                            <span>Reiniciar mi progreso (Empezar de 0)</span>
                        </span>
                    </button>

                    <button type="button" onclick="cerrarSesion()" class="w-full px-4 py-3 flex items-center justify-between text-red-600 hover:bg-red-50 transition cursor-pointer">
                        <span class="flex items-center gap-2.5 font-bold">
                            <i class="fa-solid fa-right-from-bracket"></i>
                            <span>Cerrar Sesión</span>
                        </span>
                    </button>
                </div>
            </main>

            <nav class="bg-white border-t border-slate-200/80 px-4 py-2 flex justify-around items-center rounded-t-3xl shadow-lg">
                <button type="button" id="nav-btn-despensa-perfil" onclick="irA('despensa')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-solid fa-box-archive text-base mb-0.5"></i>
                    <span>Despensa</span>
                </button>
                <button type="button" onclick="alert('Módulo de Recetas en desarrollo 🍳')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-solid fa-utensils text-base mb-0.5"></i>
                    <span>Recetas</span>
                </button>
                <button type="button" onclick="abrirModalAgregar()" class="w-11 h-11 rounded-full bg-[#3b630b] text-white flex items-center justify-center -mt-6 shadow-lg active:scale-95 transition cursor-pointer border-4 border-slate-50">
                    <i class="fa-solid fa-plus text-lg"></i>
                </button>
                <button type="button" onclick="alert('Módulo de Donación en desarrollo 🤝')" class="flex flex-col items-center text-slate-400 hover:text-emerald-700 text-[10px] transition cursor-pointer">
                    <i class="fa-solid fa-hand-holding-heart text-base mb-0.5"></i>
                    <span>Donar</span>
                </button>
                <button type="button" id="nav-btn-perfil-perfil" onclick="irA('perfil')" class="flex flex-col items-center text-[#3b630b] font-bold text-[10px] cursor-pointer">
                    <i class="fa-solid fa-user text-base mb-0.5"></i>
                    <span>Perfil</span>
                </button>
            </nav>
        </div>

    </div>

    <!-- MODAL 1: AUTENTICACIÓN -->
    <div id="modal-login" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-3xl p-5 w-full max-w-[320px] shadow-2xl text-center relative border border-slate-100">
            <div class="flex bg-slate-100 p-1 rounded-2xl mb-4">
                <button type="button" id="tab-login" onclick="cambiarModoModal('login')" class="flex-1 py-1.5 text-xs font-bold rounded-xl bg-white shadow-sm text-emerald-800 transition cursor-pointer">
                    Iniciar Sesión
                </button>
                <button type="button" id="tab-registro" onclick="cambiarModoModal('registro')" class="flex-1 py-1.5 text-xs font-semibold rounded-xl text-slate-500 hover:text-slate-800 transition cursor-pointer">
                    Crear Cuenta
                </button>
            </div>

            <h2 id="modal-titulo" class="text-emerald-800 text-lg font-bold mb-3">Iniciar Sesión</h2>

            <form onsubmit="procesarFormulario(event)">
                <div id="campos-login" class="space-y-2.5 mb-3">
                    <div class="flex items-center bg-slate-50 rounded-2xl px-3 py-2.5 border border-slate-200 focus-within:border-emerald-600 transition">
                        <i class="fa-regular fa-envelope text-slate-400 mr-2 text-sm"></i>
                        <input type="email" placeholder="Ingresa tu correo" class="bg-transparent text-xs w-full text-slate-700 outline-none">
                    </div>

                    <div class="flex items-center bg-slate-50 rounded-2xl px-3 py-2.5 border border-slate-200 focus-within:border-emerald-600 transition">
                        <i class="fa-solid fa-lock text-slate-400 mr-2 text-sm"></i>
                        <input type="password" id="pass-login" placeholder="Ingresa tu contraseña" class="bg-transparent text-xs w-full text-slate-700 outline-none">
                        <button type="button" onclick="togglePassword('pass-login', 'eye-login')" class="p-1 cursor-pointer">
                            <i id="eye-login" class="fa-solid fa-eye text-slate-400 text-xs"></i>
                        </button>
                    </div>
                </div>

                <div id="campos-registro" class="space-y-2.5 mb-3 hidden text-left">
                    <p class="text-[11px] font-bold text-slate-600 mb-1">Tipo de usuario:</p>
                    <input type="hidden" id="perfil-tipo-input" value="hogar">
                    <div class="flex gap-2 mb-2">
                        <button type="button" id="btn-perfil-hogar" onclick="seleccionarPerfil('hogar')" class="flex-1 py-2 rounded-xl text-xs font-bold border-2 border-emerald-600 bg-emerald-50 text-emerald-800 flex items-center justify-center gap-1.5 transition cursor-pointer">
                            <i class="fa-solid fa-house text-xs"></i> Hogar
                        </button>
                        <button type="button" id="btn-perfil-comercio" onclick="seleccionarPerfil('comercio')" class="flex-1 py-2 rounded-xl text-xs font-semibold border-2 border-slate-200 bg-slate-50 text-slate-600 hover:bg-slate-100 flex items-center justify-center gap-1.5 transition cursor-pointer">
                            <i class="fa-solid fa-store text-xs"></i> Comercio
                        </button>
                    </div>

                    <div class="flex items-center bg-slate-50 rounded-2xl px-3 py-2 border border-slate-200 focus-within:border-emerald-600 transition">
                        <i class="fa-regular fa-user text-slate-400 mr-2 text-sm"></i>
                        <input type="text" placeholder="Nombre completo" class="bg-transparent text-xs w-full text-slate-700 outline-none">
                    </div>

                    <div class="flex items-center bg-slate-50 rounded-2xl px-3 py-2 border border-slate-200 focus-within:border-emerald-600 transition">
                        <i class="fa-regular fa-envelope text-slate-400 mr-2 text-sm"></i>
                        <input type="email" placeholder="Correo electrónico" class="bg-transparent text-xs w-full text-slate-700 outline-none">
                    </div>

                    <div class="flex items-center bg-slate-50 rounded-2xl px-3 py-2 border border-slate-200 focus-within:border-emerald-600 transition">
                        <i class="fa-solid fa-lock text-slate-400 mr-2 text-sm"></i>
                        <input type="password" id="pass-reg1" placeholder="Contraseña" class="bg-transparent text-xs w-full text-slate-700 outline-none">
                        <button type="button" onclick="togglePassword('pass-reg1', 'eye-reg1')" class="p-1 cursor-pointer">
                            <i id="eye-reg1" class="fa-solid fa-eye text-slate-400 text-xs"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" id="btn-submit-modal" class="w-full bg-[#3b630b] hover:bg-[#2d4c08] text-white text-xs font-bold py-2.5 rounded-full shadow-md mb-2.5 cursor-pointer">
                    Iniciar sesión
                </button>
            </form>

            <button type="button" onclick="cerrarLogin()" class="mt-2 text-[11px] text-slate-400 hover:text-slate-600 underline cursor-pointer">
                Cerrar
            </button>
        </div>
    </div>

    <!-- MODAL 2: AGREGAR ALIMENTO -->
    <div id="modal-agregar" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-3xl p-5 w-full max-w-[320px] shadow-2xl relative border border-slate-100 space-y-3">
            <h3 class="text-sm font-bold text-slate-800 mb-2 text-center">🥑 Agregar a Mi Despensa</h3>
            
            <div>
                <label class="text-[10px] font-bold text-slate-600 block mb-1">Foto del alimento:</label>
                <input type="file" id="nueva-foto-file" accept="image/*" capture="environment" onchange="previsualizarFotoAlimento(event)" class="hidden">
                <button type="button" onclick="document.getElementById('nueva-foto-file').click()" class="w-full h-24 border-2 border-dashed border-emerald-300 bg-emerald-50/50 rounded-2xl flex flex-col items-center justify-center text-slate-500 hover:bg-emerald-50 transition cursor-pointer overflow-hidden relative">
                    <img id="preview-foto-alimento" src="" class="absolute inset-0 w-full h-full object-cover hidden">
                    <div id="placeholder-foto-alimento" class="flex flex-col items-center">
                        <i class="fa-solid fa-camera text-emerald-700 text-xl mb-1"></i>
                        <span class="text-[10px] font-bold text-emerald-900">Tomar foto o subir imagen</span>
                    </div>
                </button>
            </div>

            <div>
                <label class="text-[10px] font-bold text-slate-600 block mb-1">Nombre del alimento:</label>
                <input type="text" id="nuevo-nombre" placeholder="Ej. Manzanas, Leche..." class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 h-9 text-xs text-slate-700 outline-none focus:border-emerald-600">
            </div>

            <div class="grid grid-cols-2 gap-2.5 items-end">
                <div class="flex flex-col">
                    <label class="text-[10px] font-bold text-slate-600 mb-1 leading-none h-3 flex items-center">Cantidad:</label>
                    <input type="text" id="nueva-cantidad" placeholder="Ej. 3 pcs / 1 Litro" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-2.5 h-9 text-xs text-slate-700 outline-none focus:border-emerald-600">
                </div>
                <div class="flex flex-col">
                    <label class="text-[10px] font-bold text-slate-600 mb-1 leading-none h-3 flex items-center truncate">Vencimiento:</label>
                    <input type="date" id="nueva-fecha-cal" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-2 h-9 text-xs text-slate-700 outline-none focus:border-emerald-600 cursor-pointer">
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button type="button" onclick="cerrarModalAgregar()" class="flex-1 py-2.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer">
                    Cancelar
                </button>
                <button type="button" onclick="guardarAlimento()" class="flex-1 bg-[#3b630b] hover:bg-[#2d4c08] text-white py-2.5 rounded-xl text-xs font-bold shadow-md transition cursor-pointer">
                    Guardar
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL 3: FILTROS -->
    <div id="modal-filtros" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-3xl p-5 w-full max-w-[320px] shadow-2xl relative border border-slate-100 space-y-4">
            <h3 class="text-sm font-bold text-slate-800 text-center flex items-center justify-center gap-2">
                <i class="fa-solid fa-sliders text-emerald-700"></i> Filtrar y Ordenar
            </h3>

            <div class="space-y-3 text-xs">
                <div>
                    <label class="font-bold text-slate-700 block mb-1">Ordenar por:</label>
                    <select id="select-orden" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-slate-700 outline-none">
                        <option value="vencimiento">📅 Más próximos a vencer</option>
                        <option value="nombre">🔤 Nombre (A - Z)</option>
                        <option value="reciente">✨ Agregados recientemente</option>
                    </select>
                </div>

                <div>
                    <label class="font-bold text-slate-700 block mb-1">Ubicación:</label>
                    <select id="select-ubicacion" class="w-full bg-slate-50 border border-slate-200 rounded-xl p-2 text-slate-700 outline-none">
                        <option value="todas">Todas las ubicaciones</option>
                        <option value="Refrigerador">❄️ Refrigerador</option>
                        <option value="Despensa">🌾 Despensa</option>
                        <option value="Frutero">🍌 Frutero</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-2 pt-2">
                <button type="button" onclick="cerrarModalFiltros()" class="flex-1 py-2 rounded-xl text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer">
                    Cancelar
                </button>
                <button type="button" onclick="aplicarFiltrosAvanzados()" class="flex-1 bg-[#3b630b] text-white py-2 rounded-xl text-xs font-bold shadow-md transition cursor-pointer">
                    Aplicar
                </button>
            </div>
        </div>
    </div>

    <!-- Script principal -->
    <script src="app.js"></script>
</body>
</html>
